---
// Pure simulation logic + types live in src/lib/financiele-simulatie.ts
// (tested in financiele-simulatie.test.ts). This component only handles UI.
---

<div class="financiele-simulatie">
  <div class="sim-warning">
    <strong>⚠️ Work in progress — niet indicatief voor de realiteit</strong>
    <p>Deze calculator is een denkgereedschap, geen prognose. De getallen, formules en aannames zijn nog in beweging en bedoeld om gesprekken over het financiële model te ondersteunen. Verwacht geen accurate voorspellingen — kijk naar de richting en de gevoeligheden, niet naar de exacte uitkomsten.</p>
  </div>

  <h3>📈 5-jaars financiële simulatie</h3>
  <p>Twee aparte prognoses: één voor de stichting (gedreven door ecosysteem-groei en eigen budgetkeuzes) en één voor de BV (afhankelijk van wat de stichting uitbesteedt en welk marktaandeel de BV pakt onder gemeenten).</p>

  <!-- ============================================================= -->
  <!-- SECTIE 1: STICHTING                                            -->
  <!-- ============================================================= -->
  <section class="sim-section">
    <h3>🏛️ Stichting Prognose</h3>

    <div class="sim-inputs">
      <fieldset class="sim-group">
        <legend>Adoptie &amp; ecosysteem-groei</legend>

        <div class="input-group">
          <label for="s-startGemeenten"><strong>Gemeenten jaar 1:</strong> <span id="s-startGemeenten-val">5</span></label>
          <input type="range" id="s-startGemeenten" min="0" max="50" value="5" step="1" />
        </div>
        <div class="input-group">
          <label for="s-gemeenteGroei"><strong>Nieuwe gemeenten/jaar:</strong> <span id="s-gemeenteGroei-val">8</span></label>
          <input type="range" id="s-gemeenteGroei" min="0" max="30" value="8" step="1" />
        </div>
        <div class="input-group">
          <label for="s-schaal"><strong>Gemiddelde gemeentegrootte:</strong></label>
          <select id="s-schaal">
            <option value="micro">Micro (&lt; 5k)</option>
            <option value="klein">Klein (10–20k)</option>
            <option value="klein-mid">Klein–mid (20–35k)</option>
            <option value="mid" selected>Mid (35–60k)</option>
            <option value="mid-groot">Mid–groot (60–100k)</option>
            <option value="groot">Groot (100–150k)</option>
          </select>
        </div>
        <div class="input-group">
          <label for="s-startSuppliers"><strong>Preferred suppliers jaar 1:</strong> <span id="s-startSuppliers-val">3</span></label>
          <input type="range" id="s-startSuppliers" min="0" max="15" value="3" step="1" />
        </div>
        <div class="input-group">
          <label for="s-supplierGroei"><strong>Nieuwe suppliers/jaar:</strong> <span id="s-supplierGroei-val">1</span></label>
          <input type="range" id="s-supplierGroei" min="0" max="5" value="1" step="1" />
        </div>
        <div class="input-group">
          <label for="s-startSaas"><strong>SaaS-aanbieders jaar 1:</strong> <span id="s-startSaas-val">1</span></label>
          <input type="range" id="s-startSaas" min="0" max="10" value="1" step="1" />
        </div>
        <div class="input-group">
          <label for="s-saasGroei"><strong>Nieuwe SaaS-aanbieders/jaar:</strong> <span id="s-saasGroei-val">1</span></label>
          <input type="range" id="s-saasGroei" min="0" max="5" value="1" step="1" />
        </div>
        <div class="input-group">
          <label for="s-tariefPerDoc"><strong>Tarief per document (€):</strong> <span id="s-tariefPerDoc-val">0.10</span></label>
          <input type="range" id="s-tariefPerDoc" min="0" max="0.50" value="0.10" step="0.01" />
          <small>Afdracht per gegenereerd document naar de stichting.</small>
        </div>
        <div class="input-group">
          <label for="s-docsPerSaas"><strong>Documenten per SaaS-aanbieder (per jaar):</strong> <span id="s-docsPerSaas-val">250.000</span></label>
          <input type="range" id="s-docsPerSaas" min="0" max="2000000" value="250000" step="50000" />
          <small>Gemiddeld aantal documenten per SaaS-aanbieder. Bij 250.000 = ±700/dag.</small>
        </div>
      </fieldset>

      <fieldset class="sim-group">
        <legend>Stichting-uitgaven</legend>

        <div class="input-group">
          <label for="s-onderhoud"><strong>Onderhoudsbudget (k€/jaar):</strong> <span id="s-onderhoud-val">250</span></label>
          <input type="range" id="s-onderhoud" min="0" max="800" value="250" step="25" />
          <small>Basis-onderhoud (security, deps, infra, bugs). Uitbesteed onder cost-plus, ongeveer 2 FTE-equivalent.</small>
        </div>
        <div class="input-group">
          <label for="s-features"><strong>Features-budget (k€/jaar):</strong> <span id="s-features-val">50</span></label>
          <input type="range" id="s-features" min="0" max="500" value="50" step="25" />
          <small>Proactieve productevolutie. Met 0 is het scenario zuiver reactief.</small>
        </div>
        <div class="input-group">
          <label for="s-admin"><strong>Administratie + stewards (k€/jaar):</strong> <span id="s-admin-val">25</span></label>
          <input type="range" id="s-admin" min="5" max="80" value="25" step="5" />
        </div>
        <div class="input-group">
          <label for="s-investering"><strong>Initiële investering (k€):</strong> <span id="s-investering-val">100</span></label>
          <input type="range" id="s-investering" min="0" max="500" value="100" step="10" />
        </div>
      </fieldset>
    </div>

    <h4>📈 Stichting inkomsten per jaar</h4>
    <div class="sim-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Jaar</th>
            <th>Gemeenten</th>
            <th>Suppliers</th>
            <th>SaaS</th>
            <th>Licenties</th>
            <th>Certificering</th>
            <th>Per-document</th>
            <th>Totaal in</th>
          </tr>
        </thead>
        <tbody id="s-inkomsten-tbody"></tbody>
      </table>
    </div>

    <h4>📉 Stichting uitgaven per jaar</h4>
    <div class="sim-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Jaar</th>
            <th>Onderhoud</th>
            <th>Features</th>
            <th>Admin</th>
            <th>Totaal uit</th>
          </tr>
        </thead>
        <tbody id="s-uitgaven-tbody"></tbody>
      </table>
    </div>

    <h4>⚖️ Stichting resultaat per jaar</h4>
    <div class="sim-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Jaar</th>
            <th>Inkomsten</th>
            <th>Uitgaven</th>
            <th>Resultaat</th>
            <th>Cumulatief</th>
          </tr>
        </thead>
        <tbody id="s-resultaat-tbody"></tbody>
      </table>
    </div>

    <h4>Inkomstenstreams over 5 jaar (gestapeld)</h4>
    <div class="sim-chart" id="s-chart" aria-label="Inkomstenstreams gestapeld per jaar"></div>
    <div class="sim-legend">
      <span><i class="legend-swatch licentie"></i> Licenties</span>
      <span><i class="legend-swatch cert"></i> Certificering</span>
      <span><i class="legend-swatch perdoc"></i> Per-document</span>
    </div>

    <div class="sim-milestones" id="s-milestones"></div>
    <div class="sim-voordelen" id="s-voordelen"></div>
  </section>

  <!-- ============================================================= -->
  <!-- SECTIE 2: BV                                                   -->
  <!-- ============================================================= -->
  <section class="sim-section">
    <h3>🏢 BV Prognose</h3>
    <p class="sim-explainer">BV ontvangt budgetten van de stichting (zie boven) en concurreert om gemeente-diensten als één van de preferred suppliers. Hieronder zie je hoe BV's positie afhangt van het ecosysteem.</p>

    <div class="sim-inputs">
      <fieldset class="sim-group">
        <legend>BV in het ecosysteem</legend>

        <div class="input-group">
          <label for="b-aandeelOnderhoud"><strong>Aandeel stichting-onderhoud naar BV:</strong> <span id="b-aandeelOnderhoud-val">100</span>%</label>
          <input type="range" id="b-aandeelOnderhoud" min="0" max="100" value="100" step="10" />
          <small>BV is de meest voor de hand liggende partij voor platform-onderhoud, maar de stichting kan delen aan andere suppliers uitbesteden.</small>
        </div>
        <div class="input-group">
          <label for="b-aandeelFeatures"><strong>Aandeel stichting-features naar BV:</strong> <span id="b-aandeelFeatures-val">100</span>%</label>
          <input type="range" id="b-aandeelFeatures" min="0" max="100" value="100" step="10" />
        </div>
        <div class="input-group">
          <label for="b-aandeelGemeenten"><strong>Aandeel gemeenten dat BV als supplier kiest:</strong> <span id="b-aandeelGemeenten-val">40</span>%</label>
          <input type="range" id="b-aandeelGemeenten" min="0" max="100" value="40" step="5" />
          <small>Naarmate het ecosysteem groeit verschuift dit aandeel. BV kan absoluut groeien terwijl haar relatieve aandeel daalt.</small>
        </div>
      </fieldset>

      <fieldset class="sim-group">
        <legend>BV operationele parameters</legend>

        <div class="input-group">
          <label for="b-omzetGem"><strong>BV-omzet per BV-gemeente (k€/jaar):</strong> <span id="b-omzetGem-val">15</span></label>
          <input type="range" id="b-omzetGem" min="0" max="50" value="15" step="1" />
          <small>Training, consultancy, dienstverlening, marge op licentie. Cost-plus.</small>
        </div>
        <div class="input-group">
          <label for="b-fteKosten"><strong>Kosten per FTE (all-in, k€/jaar):</strong> <span id="b-fteKosten-val">100</span></label>
          <input type="range" id="b-fteKosten" min="60" max="140" value="100" step="5" />
        </div>
        <div class="input-group">
          <label for="b-overhead"><strong>Overhead-factor:</strong> <span id="b-overhead-val">1.30</span></label>
          <input type="range" id="b-overhead" min="1.0" max="1.6" value="1.3" step="0.05" />
        </div>
      </fieldset>
    </div>

    <h4>📈 BV inkomsten per jaar</h4>
    <div class="sim-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Jaar</th>
            <th>FTE</th>
            <th>Van stichting (onderhoud)</th>
            <th>Van stichting (features)</th>
            <th>Van gemeenten</th>
            <th>Totaal in</th>
          </tr>
        </thead>
        <tbody id="b-inkomsten-tbody"></tbody>
      </table>
    </div>

    <h4>📉 BV uitgaven en resultaat</h4>
    <p class="sim-explainer">FTE-capaciteit volgt uit beschikbaar budget ÷ kosten per FTE. De BV staft conservatief — de gekozen FTE is naar beneden afgerond, zodat het verschil (de buffer) altijd positief blijft en als overwinst terugvloeit naar de gemeenschap.</p>
    <div class="sim-table-wrap">
      <table>
        <thead>
          <tr>
            <th>Jaar</th>
            <th>Inkomsten</th>
            <th>Kosten/FTE</th>
            <th>Beoogd FTE</th>
            <th>Gekozen FTE</th>
            <th>FTE-kosten</th>
            <th>Buffer (resultaat)</th>
          </tr>
        </thead>
        <tbody id="b-uitgaven-tbody"></tbody>
      </table>
    </div>
  </section>

  <script>
    import tarieven from '../data/licentie-tarieven.json';
    import {
      simulateStichting,
      simulateBV,
      berekenMijlpalen,
      berekenVoordelen,
      type StichtingInputs,
      type BVInputs,
      type StichtingResult,
      type BVResult,
      type Tarieven,
    } from '../lib/financiele-simulatie';

    const tarievenTyped = tarieven as Tarieven;

    const fmt = new Intl.NumberFormat('nl-NL', {
      style: 'currency',
      currency: 'EUR',
      maximumFractionDigits: 0,
    });

    function bind(id: string, valId: string | null = null, decimals = 0) {
      const el = document.getElementById(id) as HTMLInputElement;
      const val = valId ? document.getElementById(valId) : null;
      el.addEventListener('input', () => {
        if (val) val.textContent = decimals > 0 ? parseFloat(el.value).toFixed(decimals) : el.value;
        render();
      });
      return el;
    }

    // Stichting inputs
    const sStartGemeenten = bind('s-startGemeenten', 's-startGemeenten-val');
    const sGemeenteGroei = bind('s-gemeenteGroei', 's-gemeenteGroei-val');
    const sSchaal = bind('s-schaal');
    const sStartSuppliers = bind('s-startSuppliers', 's-startSuppliers-val');
    const sSupplierGroei = bind('s-supplierGroei', 's-supplierGroei-val');
    const sStartSaas = bind('s-startSaas', 's-startSaas-val');
    const sSaasGroei = bind('s-saasGroei', 's-saasGroei-val');
    const sTariefPerDoc = bind('s-tariefPerDoc', 's-tariefPerDoc-val', 2);

    // Docs-slider toont met duizendtal-separator
    const sDocsPerSaas = document.getElementById('s-docsPerSaas') as HTMLInputElement;
    const sDocsPerSaasVal = document.getElementById('s-docsPerSaas-val')!;
    const docsFmt = new Intl.NumberFormat('nl-NL');
    sDocsPerSaas.addEventListener('input', () => {
      sDocsPerSaasVal.textContent = docsFmt.format(parseInt(sDocsPerSaas.value, 10));
      render();
    });
    const sOnderhoud = bind('s-onderhoud', 's-onderhoud-val');
    const sFeatures = bind('s-features', 's-features-val');
    const sAdmin = bind('s-admin', 's-admin-val');
    const sInvestering = bind('s-investering', 's-investering-val');

    // BV inputs
    const bAandeelOnderhoud = bind('b-aandeelOnderhoud', 'b-aandeelOnderhoud-val');
    const bAandeelFeatures = bind('b-aandeelFeatures', 'b-aandeelFeatures-val');
    const bAandeelGemeenten = bind('b-aandeelGemeenten', 'b-aandeelGemeenten-val');
    const bOmzetGem = bind('b-omzetGem', 'b-omzetGem-val');
    const bFteKosten = bind('b-fteKosten', 'b-fteKosten-val');
    const bOverhead = bind('b-overhead', 'b-overhead-val', 2);

    function getStichtingInputs(): StichtingInputs {
      return {
        startGemeenten: parseInt(sStartGemeenten.value, 10),
        gemeenteGroei: parseInt(sGemeenteGroei.value, 10),
        schaalId: sSchaal.value,
        startSuppliers: parseInt(sStartSuppliers.value, 10),
        supplierGroei: parseInt(sSupplierGroei.value, 10),
        startSaasAanbieders: parseInt(sStartSaas.value, 10),
        saasGroei: parseInt(sSaasGroei.value, 10),
        tariefPerDoc: parseFloat(sTariefPerDoc.value),
        docsPerSaasAanbieder: parseInt(sDocsPerSaas.value, 10),
        onderhoudsbudget: parseInt(sOnderhoud.value, 10) * 1000,
        features: parseInt(sFeatures.value, 10) * 1000,
        admin: parseInt(sAdmin.value, 10) * 1000,
        investering: parseInt(sInvestering.value, 10) * 1000,
      };
    }

    function getBVInputs(): BVInputs {
      return {
        aandeelOnderhoud: parseInt(bAandeelOnderhoud.value, 10) / 100,
        aandeelFeatures: parseInt(bAandeelFeatures.value, 10) / 100,
        aandeelGemeenten: parseInt(bAandeelGemeenten.value, 10) / 100,
        bvOmzetPerGemeente: parseInt(bOmzetGem.value, 10) * 1000,
        fteKosten: parseInt(bFteKosten.value, 10) * 1000,
        overhead: parseFloat(bOverhead.value),
      };
    }

    function render() {
      const stichting = simulateStichting(getStichtingInputs(), tarievenTyped);
      const bv = simulateBV(stichting, getBVInputs());
      renderStichtingInkomsten(stichting);
      renderStichtingUitgaven(stichting);
      renderStichtingResultaat(stichting);
      renderInkomstenChart(stichting);
      renderMilestones(stichting);
      renderVoordelen(stichting);
      renderBVInkomsten(bv);
      renderBVUitgaven(bv);
    }

    function renderStichtingInkomsten(s: StichtingResult) {
      const tbody = document.getElementById('s-inkomsten-tbody')!;
      tbody.innerHTML = s.rows
        .map(
          (r) => `
        <tr>
          <td>${r.jaar}</td>
          <td>${r.gemeenten}</td>
          <td>${r.suppliers}</td>
          <td>${r.saasAanbieders}</td>
          <td>${fmt.format(r.licentieInkomsten)}</td>
          <td>${fmt.format(r.certInkomsten)}</td>
          <td>${fmt.format(r.perDocInkomsten)}</td>
          <td><strong>${fmt.format(r.totaalInkomsten)}</strong></td>
        </tr>`
        )
        .join('');
    }

    function renderStichtingUitgaven(s: StichtingResult) {
      const tbody = document.getElementById('s-uitgaven-tbody')!;
      tbody.innerHTML = s.rows
        .map(
          (r) => `
        <tr>
          <td>${r.jaar}</td>
          <td>${fmt.format(r.onderhoudsbudget)}</td>
          <td>${fmt.format(r.featureBudget)}</td>
          <td>${fmt.format(r.adminKosten)}</td>
          <td><strong>${fmt.format(r.stichtingKosten)}</strong></td>
        </tr>`
        )
        .join('');
    }

    function renderStichtingResultaat(s: StichtingResult) {
      const tbody = document.getElementById('s-resultaat-tbody')!;
      tbody.innerHTML = s.rows
        .map(
          (r) => `
        <tr>
          <td>${r.jaar}</td>
          <td>${fmt.format(r.totaalInkomsten)}</td>
          <td>${fmt.format(r.stichtingKosten)}</td>
          <td class="${r.stichtingResultaat >= 0 ? 'positief' : 'negatief'}">${fmt.format(r.stichtingResultaat)}</td>
          <td class="${r.cumulatief >= 0 ? 'positief' : 'negatief'}">${fmt.format(r.cumulatief)}</td>
        </tr>`
        )
        .join('');
    }

    function renderInkomstenChart(s: StichtingResult) {
      const max = Math.max(...s.rows.map((r) => r.totaalInkomsten));
      const chart = document.getElementById('s-chart')!;
      const stack = (cls: string, val: number, label: string) => {
        if (val <= 0) return '';
        const pct = max > 0 ? (val / max) * 100 : 0;
        return `<div class="stack ${cls}" style="height: ${pct}%" title="${label}: ${fmt.format(val)}"></div>`;
      };
      chart.innerHTML = s.rows
        .map(
          (r) => `
            <div class="bar-group" aria-label="Jaar ${r.jaar}">
              <div class="bars stacked">
                ${stack('perdoc', r.perDocInkomsten, 'Per-doc')}
                ${stack('cert', r.certInkomsten, 'Cert')}
                ${stack('licentie', r.licentieInkomsten, 'Licentie')}
              </div>
              <div class="bar-label">J${r.jaar}</div>
            </div>`
        )
        .join('');
    }

    function renderMilestones(s: StichtingResult) {
      const mp = berekenMijlpalen(s);
      const items = [
        mp.operationeleBreakEvenJaar !== null
          ? `<li>✅ <strong>Operationele break-even</strong> in jaar ${mp.operationeleBreakEvenJaar}</li>`
          : `<li>⚠️ <strong>Geen operationele break-even</strong> binnen 5 jaar bij deze aannames</li>`,
        mp.investeringTerugverdiendJaar !== null
          ? `<li>✅ <strong>Investering terugverdiend</strong> in jaar ${mp.investeringTerugverdiendJaar}</li>`
          : `<li>⚠️ <strong>Investering niet terugverdiend</strong> binnen 5 jaar</li>`,
        mp.overwinstJaar !== null
          ? `<li>✅ <strong>Overschot beschikbaar</strong> vanaf jaar ${mp.overwinstJaar} (boven investering + €100k buffer)</li>`
          : `<li>⏸️ <strong>Nog geen overschot</strong> binnen 5 jaar</li>`,
      ];
      const milestones = document.getElementById('s-milestones')!;
      milestones.innerHTML = `<h4>Mijlpalen (stichting cashflow)</h4><ul>${items.join('')}</ul>`;
    }

    function renderVoordelen(s: StichtingResult) {
      const v = berekenVoordelen(s);
      const el = document.getElementById('s-voordelen')!;
      el.innerHTML = `
        <h4>🌱 Voordelen voor de gemeenschap (5 jaar)</h4>
        <ul>
          <li>Totaal onderhoud uitbesteed: <strong>${fmt.format(v.totaalOnderhoudsbudget)}</strong></li>
          <li>Totaal feature-ontwikkeling: <strong>${fmt.format(v.totaalFeatureBudget)}</strong></li>
          <li>Gemeenten op platform aan einde jaar 5: <strong>${v.gemeentenOpHetEinde}</strong></li>
          <li>Preferred suppliers in ecosysteem: <strong>${v.suppliersOpHetEinde}</strong></li>
          <li>SaaS-aanbieders: <strong>${v.saasOpHetEinde}</strong></li>
          <li>Overschot beschikbaar voor reserve + open source-bijdragen: <strong class="${v.overschotVoorReserveEnOss >= 0 ? 'positief' : 'negatief'}">${fmt.format(v.overschotVoorReserveEnOss)}</strong></li>
        </ul>
      `;
    }

    function renderBVInkomsten(bv: BVResult) {
      const tbody = document.getElementById('b-inkomsten-tbody')!;
      tbody.innerHTML = bv.rows
        .map(
          (r) => `
        <tr>
          <td>${r.jaar}</td>
          <td>${r.fte}</td>
          <td>${fmt.format(r.vanStichtingOnderhoud)}</td>
          <td>${fmt.format(r.vanStichtingFeatures)}</td>
          <td>${fmt.format(r.vanGemeenten)}</td>
          <td><strong>${fmt.format(r.bvInkomsten)}</strong></td>
        </tr>`
        )
        .join('');
    }

    function renderBVUitgaven(bv: BVResult) {
      const tbody = document.getElementById('b-uitgaven-tbody')!;
      const decFmt = new Intl.NumberFormat('nl-NL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      tbody.innerHTML = bv.rows
        .map(
          (r) => `
        <tr>
          <td>${r.jaar}</td>
          <td>${fmt.format(r.bvInkomsten)}</td>
          <td>${fmt.format(r.kostenPerFte)}</td>
          <td>${decFmt.format(r.beoogdeFte)}</td>
          <td>${r.fte}</td>
          <td>${fmt.format(r.bvKosten)}</td>
          <td class="${r.bvResultaat >= 0 ? 'positief' : 'negatief'}">${fmt.format(r.bvResultaat)}</td>
        </tr>`
        )
        .join('');
    }

    render();
  </script>
</div>

<style>
  .financiele-simulatie {
    border: 1px solid var(--sl-color-gray-5);
    padding: 1.5rem;
    margin: 1.5rem 0;
    background-color: var(--sl-color-bg-nav);
  }

  .sim-warning {
    border: 2px solid #b04a2a;
